---
import { siYoutube, siX, siGithub, siNote, siQiita, siZenn, siBluesky, siKeybase, siSteam, siOsu } from "simple-icons";
import Link from "@/components/Link.astro";
import DiaHomeButton from "@/components/DiaHomeButton.astro";
import DiaButton from "@/components/DiaButton.astro";
import Layout from "@/layouts/Layout.astro";
