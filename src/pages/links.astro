---
import { siYoutube, siX } from "simple-icons";
import DiaHomeButton from "@/components/DiaHomeButton.astro";
import DiaButton from "@/components/DiaButton.astro";
import Layout from "@/layouts/Layout.astro";
---

<!-- Youtube:red-600  -->
<Layout>
    <div class="mt-4">
    <div class="flex items-center border-b border-zinc-600 py-4">
        <img src="https://pbs.twimg.com/profile_images/2059289946696093697/3BVGrYtW_400x400.jpg" alt="アイコン画像(ひな)" class="rounded-full size-24">
        <div class="flex flex-col mx-5 w-72">
            <h1 class="text-4xl font-bold">ひな</h1>
            <p class="mt-5 text-lg">いろいろ熱血してる人。三食団子教祖。</p>
        </div>
        <DiaHomeButton href="https://atelier-hina.vercel.app/" />
        <DiaButton href="https://x.com/UsamiH1na" path={siX.path} hovcolor="hover:text-gray-200" />
    </div>
    </div>
</Layout>