            <DiaButton href="https://x.com/UsamiH1na" path={siX.path} hovcolor="dark:hover:text-gray-200 hover:text-gray-600" />
        </Link>

        <Link name="あい" description="映像技術がすごい同級生。更にプログラミングもできる。" thumbnail="https://pbs.twimg.com/profile_images/1749099870512971776/JZMNwTli_400x400.jpg">
            <DiaHomeButton href="https://www.foriio.com/ia-cg" />
            <DiaButton href="https://www.twitter.com/twubcThcUO47Kth" path={siX.path} hovcolor="dark:hover:text-gray-200 hover:text-gray-600" />
        </Link>
        

        <Link name="しおり🔖" description="NEXUS for UECを作った先輩。この前ステッカー配ってた。" thumbnail="https://pbs.twimg.com/profile_images/2005878117399945217/KuODqIbT_400x400.jpg">
