---
import ".src/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "astro-tailwind-starter",
  description = "Minimal Astro v6 starter kit with Tailwind CSS v4, TypeScript, Prettier, and ESLint pre-configured. Ready to deploy on Cloudflare Workers.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="mx-8 my-4 bg-white dark:bg-gray-950 dark:text-white">
    <div class="lg:hidden flex items-center justify-center min-h-screen p-6 text-center">
      <p class="text-gray-700">
        このページは横幅が狭い画面での閲覧を想定していません。<br />
        画面の横幅が1024px以上の環境でご覧ください。
      </p>
    </div>

    <!-- 通常のコンテンツ: md以上でのみ表示 -->
    <div class="hidden lg:block">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
