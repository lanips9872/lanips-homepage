---
interface Props {
    status: "wip" | "finished" | "other"
    title?: string;
    description?: string;
    href?: string;
    imgSrc?: string;
    imgAlt?: string;
    className?: string;
} 

const { 
    status = "other",
    title = "", 
    description = "", 
    href = "",
    imgSrc = "", 
    imgAlt = "",
    className = "" 
} = Astro.props;

const bgcolor = {
    wip: "bg-yellow-200 dark:bg-yellow-600 hover:bg-yellow-500 transition duration-200",
    finished: "bg-green-200 dark:bg-green-700 hover:bg-green-600 transition duration-200",
    other: "bg-gray-300  dark:bg-gray-700 hover:bg-gray-600 transition duration-200"
} as const;
---

<!-- titleとdescriptionをそれぞれ任意でつけることができ、自動でそれっぽくなる -->

<a 
href={href}
class=`flex items-center my-3 mx-1.5 p-4 rounded-2xl border border-gray-500 shadow-md dark:shadow-none dark:ring-2 dark:ring-gray-600 ${bgcolor[status]} ${className}`
>
    <div class="flex flex-col justify-center">
        {status === "wip" ? (
            <div class="w-24 mb-3 text-center text-gray-500 dark:text-zinc-200">＜制作中＞</div>
        ) : (
            (status === "finished" ? (
                <div class="w-24 mb-3 text-center text-gray-500 dark:text-zinc-200">＜完成済＞</div>
            ) : (
            <div/>
            ))
        )}
        <img src={imgSrc} alt={imgAlt} class="mr-16 w-24 h-24">
    </div>
    <div class="flex flex-col text-zinc-200">
        <h1 class="text-2xl font-bold">{title}</h1>
        <p class="mt-2">{description}</p>
    </div>
    <slot />
</a>