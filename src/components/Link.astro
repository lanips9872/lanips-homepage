---
interface Props {
    name: string;
    description: string;
    thumbnail: string;
    pclassName?: string;
} const {
    name = "",
    description = "",
    thumbnail = "",
    pclassName =""
} = Astro.props;
---

<div class="flex items-center border-b border-zinc-600 py-4">
    <img src={thumbnail} alt=`アイコン画像(${name})` class="rounded-full size-24">
    <div class="flex flex-col mx-5 w-96">
        <h1 class="text-4xl">{name}</h1>
        <p class=`mt-5 text-lg text-zinc-400 ${pclassName}`>{description}</p>
    </div>
    <slot />
</div>